PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/examination_system?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Super Admin Seeding Credentials (for npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminInitialPassword123!
